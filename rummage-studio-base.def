Bootstrap: localimage
From: rummage-base.sif

%arguments
    # Server port. 8787 is the RStudio default but often collides with
    # host services (Apptainer shares the host network namespace);
    # 18787 is a safe default. Override with RSTUDIO_PORT=8787.
    RSTUDIO_PORT=18787
    # RStudio Server version: "latest" = current stable from rstudio.org;
    # or an exact version like 2026.08.2-200 (debs use "-" for "+").
    RSTUDIO_VERSION=latest

%post
    # rummage-studio-base: rummage-base (R + uvr) + RStudio Server.
    # The RStudio Server Open Source edition (AGPL) runs as a web app on
    # port 18787; rserver runs as the invoking user at run time (see the
    # runscript), so no container-side account is needed. No R packages
    # are installed here — rummage-studio-app.def builds on this image.
    #
    # Build:  make studio-base

    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C.UTF-8

    apt-get update -q && \
        apt-get install -yq --no-install-recommends \
            gdebi-core libclang-dev libssl-dev psmisc wget

    # ---- RStudio Server --------------------------------------------------
    # The jammy deb works on noble (rocker does the same substitution);
    # gdebi resolves the deb's Depends (libssl-dev, libclang-dev, ...).
    RSTUDIO_VERSION="{{ RSTUDIO_VERSION }}"
    if [ "${RSTUDIO_VERSION}" = "latest" ]; then
        DEB_URL="https://rstudio.org/download/latest/stable/server/jammy/rstudio-server-latest-amd64.deb"
    else
        DEB_URL="https://download2.rstudio.org/server/jammy/amd64/rstudio-server-${RSTUDIO_VERSION}-amd64.deb"
    fi
    wget -q "${DEB_URL}" -O /tmp/rstudio-server.deb
    gdebi --non-interactive /tmp/rstudio-server.deb
    ln -fs /usr/lib/rstudio-server/bin/rstudio-server /usr/local/bin
    ln -fs /usr/lib/rstudio-server/bin/rserver /usr/local/bin

    # Point RStudio at the R on PATH (CRAN apt repo install) and use
    # advisory file locks so the SIF's read-only /usr is safe.
    R_BIN="$(which R)"
    mkdir -p /etc/rstudio /etc/R
    cat > /etc/rstudio/logging.conf <<'EOF'
[*]
log-level=warn
logger-type=syslog
EOF
    {
        echo "rsession-which-r=${R_BIN}"
        echo "www-port={{ RSTUDIO_PORT }}"
    } > /etc/rstudio/rserver.conf
    echo "lock-type=advisory" > /etc/rstudio/file-locks

    # New R sessions must open in /work (the bind-mounted project dir),
    # not the user's home: rsession's cwd does NOT inherit from the
    # runscript's `cd /work` — rserver spawns rsession fresh at login,
    # defaulting to ~. This is the supported knob (rsession.conf).
    echo "session-default-working-dir=/work" > /etc/rstudio/rsession.conf
    # rserver runs as the invoking user at run time — make the deb's
    # database.conf readable by non-root.
    chmod o+r /etc/rstudio/database.conf

    # The deb ships a PAM template but does not install it in containers;
    # without /etc/pam.d/rstudio the login always fails.
    mkdir -p /etc/pam.d
    cp /usr/lib/rstudio-server/extras/pam/rstudio /etc/pam.d/rstudio


%runscript
    # Run RStudio Server in the foreground (--server-daemonize 0 keeps
    # the container alive). Port from the RSTUDIO_PORT build arg,
    # default 18787.
    #
    # The --scratch flag is REQUIRED — the SIF's /var is read-only:
    #   apptainer run --bind "$(pwd)":/work \
    #       --scratch /var/lib/rstudio-server,/var/log/rstudio-server,/var/run/rstudio-server \
    #       rummage-studio-base.sif
    #   → http://localhost:18787
    #   (logged in as your own user — fine for single-user)
    #
    # Any args are passed through to rstudio-server (e.g. "version").
    if [ $# -gt 0 ]; then
        exec rstudio-server "$@"
    fi
    # --server-user $(whoami): rserver runs as the invoking user, so the
    # IDE session matches the logged-in user, $HOME included.
    # TODO: fix ubuntu's uid 1000 clash.
    exec rserver --server-daemonize 0 --server-user $(whoami)

%test
    set -e
    echo "uvr: $(uvr --version)"
    echo "R:   $(Rscript -e 'cat(R.version.string)')"
    echo "RStudio Server: $(rstudio-server version)"

%labels
    Author Shern Ren Tee
    Title uvr + R + RStudio Server base runtime
    Description rummage-base plus RStudio Server (port 18787, runs as the invoking user); packages added by rummage-studio-app.def
    Version 1.0

%help
    rummage-studio-base ("rummage-studio-base.sif")
    ===============================================
    rummage-base (Ubuntu 24.04 + R + uvr) + RStudio Server Open Source.
    No R packages — build rummage-studio-app.sif from it to bake a
    package library.

    BUILD:
      make studio-base

    RUN (RStudio Server on port 18787, project bound at /work):
      apptainer run --bind "$(pwd)":/work \
          --scratch /var/lib/rstudio-server,/var/log/rstudio-server,/var/run/rstudio-server \
          rummage-studio-base.sif
      → http://localhost:18787
      (logged in as your own user — fine for single-user)

    Version pinning:
      make studio-base RSTUDIO_VERSION=2026.08.2-200
