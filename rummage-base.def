Bootstrap: docker
From: ubuntu:24.04

%arguments
    # Build args. Unset = latest R (CRAN apt repo, current 4.x line) and
    # latest uvr release. R_VERSION pins a specific R release (e.g.
    # 4.5.1), resolved to the newest matching deb in the CRAN repo. Pin with:
    #   apptainer build --build-arg R_VERSION=4.5.1 --build-arg UVR_VERSION=v0.4.6 \
    #       rummage-base.sif rummage-base.def
    R_VERSION=
    UVR_VERSION=

%post
    # uvr + R base image ("rummage-base"): Ubuntu 24.04, R, and the uvr
    # binary. No packages are installed here — rummage-app.def builds on
    # this image and bakes the package library from its uvr.toml.
    #
    # Build:  apptainer build rummage-base.sif rummage-base.def

    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C.UTF-8

    # Locale and timezone for the image (analysis outputs carry timestamps).
    IMAGE_LOCALE="en_AU.UTF-8"
    IMAGE_TZ="Australia/Brisbane"

    # ---- base OS packages ----------------------------------------------
    apt-get update -q && \
        apt-get install -yq --no-install-recommends \
            ca-certificates curl wget git fontconfig gnupg locales tzdata

    # ---- locale + timezone ----------------------------------------------
    sed -i "s/^# *${IMAGE_LOCALE}/${IMAGE_LOCALE}/" /etc/locale.gen
    locale-gen
    update-locale LANG="${IMAGE_LOCALE}" LC_ALL="${IMAGE_LOCALE}"
    ln -sf "/usr/share/zoneinfo/${IMAGE_TZ}" /etc/localtime
    echo "${IMAGE_TZ}" > /etc/timezone
    # ---- R ---------------------------------------------------------------
    # Both branches install R from the CRAN Ubuntu apt repo
    # (https://cran.r-project.org/bin/linux/ubuntu/), so the compiler
    # toolchain (r-base-dev) always matches the installed R — source
    # fallbacks like terra compile cleanly.
    CODENAME="$(. /etc/os-release && echo "${VERSION_CODENAME}")"
    wget -qO /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc \
        https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc
    echo "deb https://cloud.r-project.org/bin/linux/ubuntu ${CODENAME}-cran40/" \
        > /etc/apt/sources.list.d/cran-r.list
    apt-get update -qq
    PINNED_R_VERSION="{{ R_VERSION }}"
    if [ -n "${PINNED_R_VERSION}" ]; then
        # Pin core, the metapackage, recommended, and dev to ONE exact deb
        # version: r-base-dev's r-base-core dependency is (>= ...), so a
        # bare ${R_VERSION}-style pin would let apt drift core to latest.
        # The repo index carries every historical point release; pick the
        # newest deb matching ${R_VERSION}.*.
        PIN_APT_VERSION="$(apt-cache madison r-base-core \
            | grep -E "\| ${PINNED_R_VERSION}-" | awk '{print $3}' | sort -rV | head -1)"
        if [ -z "${PIN_APT_VERSION}" ]; then
            echo "ERROR: R ${PINNED_R_VERSION} not found in the CRAN ${CODENAME}-cran40 repo." >&2
            echo "Available r-base-core versions:" >&2
            apt-cache madison r-base-core | awk '{print "  " $3}' >&2
            exit 1
        fi
        apt-get install -yq --no-install-recommends \
            "r-base=${PIN_APT_VERSION}" \
            "r-base-core=${PIN_APT_VERSION}" \
            "r-recommended=${PIN_APT_VERSION}" \
            "r-base-dev=${PIN_APT_VERSION}"
    else
        apt-get install -yq --no-install-recommends r-base r-base-dev
    fi
    R --version | head -1

    # ---- uvr binary -------------------------------------------------------
    PINNED_UVR_VERSION="{{ UVR_VERSION }}"
    if [ -n "${PINNED_UVR_VERSION}" ]; then
        pinned_tag="${PINNED_UVR_VERSION}"
    else
        pinned_tag="latest"
    fi
    curl -fsSL "https://github.com/nbafrank/uvr/releases/${pinned_tag}/download/uvr-x86_64-unknown-linux-gnu.tar.gz" \
        -o /tmp/uvr.tar.gz
    tar xzf /tmp/uvr.tar.gz -C /tmp && mv /tmp/uvr /usr/local/bin/uvr && chmod +x /usr/local/bin/uvr
    rm -f /tmp/uvr.tar.gz
    uvr --version

%environment
    export LC_ALL=en_AU.UTF-8
    export LANG=en_AU.UTF-8
    export TZ=Australia/Brisbane

%test
    set -e
    echo "uvr: $(uvr --version)"
    echo "R:   $(Rscript -e 'cat(R.version.string)')"
    echo "R locale/TZ: $(Rscript -e 'cat(Sys.getlocale("LC_TIME"), "|", format(Sys.time(), "%Z %z"))')"

%labels
    Author APSIM Initiative
    Title uvr + R base runtime
    Description Ubuntu 24.04 + R + uvr binary; package library added by rummage-app.def
    Version 1.0

%help
    uvr + R base image ("rummage-base")
    ===================================
    Ubuntu 24.04 + R (latest, or a pinned release, from the CRAN apt
    repo; r-base-dev toolchain included) + the uvr binary. This image
    has NO R packages — build rummage-app.sif from it to bake a library.

    Version pinning (both optional, default = latest):
      apptainer build --build-arg R_VERSION=4.5.1 --build-arg UVR_VERSION=v0.4.6 \
          rummage-base.sif rummage-base.def

    BUILD:
      apptainer build rummage-base.sif rummage-base.def